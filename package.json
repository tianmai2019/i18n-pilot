{
  "name": "i18n-pilot",
  "version": "0.1.1",
  "description": "I18n quality gate and debt scanner for modern frontend projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "i18n-pilot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "i18n",
    "localization",
    "l10n",
    "scanner",
    "quality",
    "ci",
    "cli"
  ],
  "author": "PanZhang",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^11.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "node-fetch": "^3.3.2",
    "ora": "^9.4.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.8.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
